<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is the black field of the home screen; Compose draws everything above it. -->
    <style name="Theme.Mail" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#FF1F3354</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF1F3354</item>
    </style>
</resources>
