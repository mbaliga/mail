# Generated by You've got Mail. Change the rules in the app; this script is replaced when they change.
require ["imap4flags", "fileinto"];

# GitHub to its folder (rule 1)
if address :domain :matches "from" ["github.com", "*.github.com"] {
    addflag "\\Seen";
    fileinto "GitHub";
}

# Lists or big multiline name (rule 3)
if anyof(header :contains "list-id" "substack", size :over 5000000) {
    addflag "\\Flagged";
    stop;
}

